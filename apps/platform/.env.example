# Copy to .env.local (git-ignored).
# The VITE_ prefix exposes a variable to the browser: only public values here.

VITE_SUPABASE_URL=
# anon / public key only. Never the service_role key.
VITE_SUPABASE_ANON_KEY=

# API base URL. It MUST include /api/v1 (the apps do not append it).
VITE_API_URL=http://localhost:3001/api/v1
